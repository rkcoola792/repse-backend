# Required application settings
NODE_ENV=development
PORT=3000
MONGO_URI=
JWT_SECRET=
BASE_URL=
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
# Use an address on a Resend-verified domain to send OTPs to arbitrary recipients.
RESEND_FROM_EMAIL=
ORDER_NOTIFICATION_EMAIL=
CLOUDINARY_URL=

# CORS origins, comma-separated; add every customer/admin frontend origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://repse-webapp.onrender.com,https://repse.in
TRUST_PROXY_HOPS=1
JSON_BODY_LIMIT=1mb
FORM_BODY_LIMIT=100kb

# Razorpay: set key ID and secret from the same account/mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional legacy mode-specific pairs (production selects LIVE, other environments TEST).
RAZORPAY_LIVE_API_KEY_ID=
RAZORPAY_LIVE_SECRET_KEY=
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=

# AWS SES (only needed by the SES mail helper)
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=

# SMS OTP is paused. Uncomment these when enabling Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# Alternative to TWILIO_MESSAGING_SERVICE_SID:
# TWILIO_PHONE_NUMBER=

# Optional OpenStreetMap-compatible reverse geocoding endpoint.
REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse

# Storefront and checkout configuration
PUBLIC_PRODUCT_PAGE_MAX=100
MAX_ORDER_ITEMS=50
MAX_ITEM_QUANTITY=20
ORDER_CURRENCY=INR
ORDER_DISCOUNT_PERCENT=20
ORDER_DELIVERY_FEE=15
RECEIPT_PREFIX=REP

# Captured payment inventory processing uses MongoDB transactions; MONGO_URI
# must connect to a replica set or sharded cluster.
